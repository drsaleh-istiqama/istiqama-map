# Copy to .env.local (never commit real values). `npm run stack:setup` generates
# a local .env.local automatically with random development secrets.

# --- API (Supabase-compatible) ------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-jwt
# Server-side only (Edge Functions / scripts). NEVER expose to the web app.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-jwt
SUPABASE_JWT_SECRET=replace-with-at-least-32-characters

# --- Database (local stack / scripts) ----------------------------------------
DATABASE_URL=postgresql://postgres@127.0.0.1:54322/istiqama
PG_PORT=54322
POSTGREST_PORT=54323
GATEWAY_PORT=54321

# --- Web app (Vite exposes only VITE_* variables) -----------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-anon-jwt
VITE_APP_NAME=خارطة مشاريع الاستقامة
VITE_APP_ENV=development
# Base URL of the PMTiles basemap and map packs on our own object storage.
VITE_TILES_URL=http://127.0.0.1:54321/storage/v1/object/public/tiles
VITE_SENTRY_DSN=

# --- Owner decisions (placeholders, see docs/OWNER_DECISIONS.md) --------------
APP_DOMAIN=example.org
# fake = codes are written to the local gateway log, nothing is sent.
OTP_PROVIDER=fake
SENTRY_DSN=
